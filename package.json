{
  "name": "pluto-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && rundot deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:audio:browser": "node scripts/audio-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:balance": "node --experimental-strip-types --no-warnings scripts/balance-check.mjs",
    "test:tuning": "node scripts/tuning-smoke.mjs",
    "test:equipment": "node scripts/equipment-smoke.mjs",
    "test:roster": "node scripts/roster-smoke.mjs",
    "test:terrain:browser": "node scripts/terrain-smoke.mjs",
    "test:browser:all": "node scripts/browser-regressions.mjs",
    "benchmark:terrain": "node scripts/terrain-benchmark.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "test:terrain:campaign": "node --experimental-strip-types --no-warnings scripts/terrain-campaign.mjs",
    "test:cover:browser": "node scripts/cover-smoke.mjs",
    "test:explosions:browser": "node scripts/explosion-smoke.mjs",
    "test:upgrades:browser": "node scripts/upgrade-smoke.mjs",
    "benchmark:explosions": "node scripts/explosion-benchmark.mjs",
    "benchmark:simulation": "node --experimental-strip-types --no-warnings scripts/simulation-benchmark.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.36.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "playwright": "1.49.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
